# Local development settings. Copy to .env and replace every placeholder. .env is git-ignored; never commit it.
# Generate strong local values with e.g.: openssl rand -hex 24
#
# Used by: docker-compose.yml (the local MySQL container), the backend under the `local` Spring profile, and the
# E2E launcher. The production stack does NOT read this file: see .env.production.example and docs/DEPLOYMENT.md
# (production secrets are Docker secret files, never environment variables in a file).
# Values marked REQUIRED have no default; the backend refuses to start without them.

# =====================================================================================================================
# Database
# =====================================================================================================================
# Local MySQL container (docker-compose.yml).
MYSQL_DATABASE=enterprise_admin
MYSQL_USER=change_me_app_user
MYSQL_PASSWORD=change_me_app_password
MYSQL_ROOT_PASSWORD=change_me_root_password
# Host port of the local MySQL container (3307 because 3306 is often taken by a native install). Local only.
MYSQL_PORT=3307

# Backend connection. REQUIRED. Must match the container above. useSSL=false is acceptable only for a local
# container; any shared or production database must use TLS (sslMode=VERIFY_IDENTITY with a trusted CA).
DB_URL=jdbc:mysql://127.0.0.1:3307/enterprise_admin?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=change_me_app_user
DB_PASSWORD=change_me_app_password
# Optional (defaults shown). Never set JPA_DDL_AUTO to create/create-drop/update: Flyway owns the schema.
# DB_POOL_MAX_SIZE=10
# JPA_DDL_AUTO=validate

# Least-privilege accounts: optional locally, REQUIRED in shared environments (the production stack always uses them).
# Create both once with docker/mysql/provision-users.sh (reads DB_MIGRATION_* / DB_RUNTIME_* below), then run the app
# as the runtime account (DB_USERNAME/DB_PASSWORD) and migrate as the migration account (FLYWAY_USER/FLYWAY_PASSWORD).
# DB_MIGRATION_USER=ea_migrator
# DB_MIGRATION_PASSWORD=change_me_migration_password
# DB_RUNTIME_USER=ea_app
# DB_RUNTIME_PASSWORD=change_me_runtime_password
# DB_RUNTIME_USER_HOST=%
# FLYWAY_USER=ea_migrator
# FLYWAY_PASSWORD=change_me_migration_password
# Run Flyway migrations at startup (default true). The production stack sets false and uses its migrate job instead.
# FLYWAY_ENABLED=true
# Proves at startup that the runtime account cannot UPDATE/DELETE audit rows (refuses to start otherwise).
# DB_VERIFY_LEAST_PRIVILEGE=false

# =====================================================================================================================
# Authentication
# =====================================================================================================================
# REQUIRED. HS256 signing secret for access tokens: at least 32 bytes of randomness.
# Generate with: openssl rand -base64 48. The backend refuses to start if it is missing, too short, or this placeholder.
JWT_SECRET=change_me_generate_with_openssl_rand_base64_48
# Optional token settings (defaults shown).
# JWT_ACCESS_TOKEN_TTL=15m
# JWT_ISSUER=enterprise-admin
# JWT_AUDIENCE=enterprise-admin-web
# REFRESH_TOKEN_TTL=7d
# REFRESH_SESSION_MAX_LIFETIME=30d
# BCRYPT_STRENGTH=12

# Refresh-token cookie. Secure=true is the default and REQUIRED in production (HTTPS);
# only local plain-HTTP development may set false.
REFRESH_COOKIE_SECURE=false
# REFRESH_COOKIE_NAME=ea_refresh_token
# REFRESH_COOKIE_SAME_SITE=Strict

# =====================================================================================================================
# Bootstrap (initial ADMIN)
# =====================================================================================================================
# Created at startup only while no ADMIN exists; existing accounts are never modified.
# Password policy: at least 12 characters, at most 72 bytes. Change it after the first sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_strong_admin_password
# ADMIN_FIRST_NAME=System
# ADMIN_LAST_NAME=Administrator

# =====================================================================================================================
# Security (HTTP hardening, rate limiting, proxy trust)
# =====================================================================================================================
# HSTS is sent on HTTPS requests only; disable only where the app is never served over TLS.
# HSTS_ENABLED=true
# jdbc = counters shared by every instance through MySQL; memory = single instance only.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STORE=jdbc
# "framework" only behind a trusted reverse proxy that overwrites X-Forwarded-*; otherwise keep "none".
# FORWARD_HEADERS_STRATEGY=none
# Directory of secret files (one file per variable, e.g. JWT_SECRET); used by the containers (/run/secrets).
# SECRETS_DIR=/run/secrets/

# =====================================================================================================================
# CORS
# =====================================================================================================================
# Comma-separated exact browser origins allowed to call the API directly. Wildcards are rejected at startup.
# Not needed with the Angular dev proxy or the production nginx proxy (same origin): leave empty there.
ALLOWED_ORIGINS=http://localhost:4200

# =====================================================================================================================
# Frontend / proxy
# =====================================================================================================================
# Local development: `npm start` serves the SPA on :4200 with the CSP from frontend/security-headers.json and proxies
# /api to the backend (frontend/proxy.conf.json). Optional backend HTTP port (default 8080):
# SERVER_PORT=8080
# The production nginx settings (HTTP_BIND, HTTP_PORT, NGINX_TRUST_FORWARDED_PROTO) live in .env.production.example.

# =====================================================================================================================
# End-to-end tests (frontend: npm run e2e)
# =====================================================================================================================
# The E2E launcher recreates the disposable enterprise_admin_e2e schema; it needs the MySQL root password
# (falls back to MYSQL_ROOT_PASSWORD above). Test fixtures only; never reuse elsewhere.
# E2E_MYSQL_ROOT_PASSWORD=change_me_root_password
