# Non-secret settings for docker-compose.prod.yml. Copy to .env.production (git-ignored) and adjust.
# Secrets are NOT set here: they are files in ./secrets (scripts/generate-secrets.sh) mounted as Docker secrets.

# Image tag to run (built locally with --build, or pulled from your registry).
APP_VERSION=1.0.0

# --- Database ---
MYSQL_DATABASE=enterprise_admin
DB_MIGRATION_USER=ea_migrator
DB_RUNTIME_USER=ea_app
# Production: require TLS to MySQL, e.g. ...?sslMode=VERIFY_IDENTITY&serverTimezone=UTC (with a trusted CA).
# DB_URL=jdbc:mysql://mysql:3306/enterprise_admin?sslMode=PREFERRED&serverTimezone=UTC

# --- Bootstrap (first start only, while no ADMIN exists; the password is the ADMIN_PASSWORD secret) ---
ADMIN_EMAIL=admin@example.com

# --- Security ---
# Keep true in production (HTTPS). Only a local HTTP trial on a non-localhost host needs false.
REFRESH_COOKIE_SECURE=true
HSTS_ENABLED=true
# Exact origins allowed to call the API cross-origin. Empty = same origin only (the nginx proxy): the default.
ALLOWED_ORIGINS=

# --- Frontend / proxy ---
# Where the frontend listens on the host. Bind to 127.0.0.1 behind a local reverse proxy; 0.0.0.0 to expose directly.
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
# "on" only when a TLS-terminating proxy in front of nginx sets X-Forwarded-Proto (enables HSTS for https).
NGINX_TRUST_FORWARDED_PROTO=off

# --- JVM (optional; container-aware defaults shown) ---
# JDK_JAVA_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
