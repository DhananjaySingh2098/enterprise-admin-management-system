# Normalise line endings in the repository so container builds and CI behave the same everywhere.
* text=auto eol=lf

# Scripts and wrappers are executed inside Linux containers: they must keep LF.
*.sh      text eol=lf
*.mjs     text eol=lf
mvnw      text eol=lf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binary assets: never normalise or diff as text.
*.ico     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.woff    binary
*.woff2   binary
*.jar     binary
