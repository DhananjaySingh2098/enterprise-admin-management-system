# Enterprise Admin — production nginx (frontend image). Rendered at container start by the nginx image's envsubst
# into /etc/nginx/conf.d/default.conf. Variables: BACKEND_UPSTREAM, NGINX_RESOLVER, NGINX_TRUST_FORWARDED_PROTO.
# Architecture: browser → this server → static SPA files, and /api/** → backend (internal network only).

# Scheme the client used. Only trust X-Forwarded-Proto from a TLS-terminating proxy in front of nginx when
# NGINX_TRUST_FORWARDED_PROTO=on; otherwise nginx's own scheme is used (a client cannot fake "https").
map $http_x_forwarded_proto $upstream_forwarded_proto {
    default $scheme;
    https   https;
    http    http;
}
map "${NGINX_TRUST_FORWARDED_PROTO}" $forwarded_proto {
    on      $upstream_forwarded_proto;
    default $scheme;
}

# HSTS only for HTTPS requests; an empty value makes nginx omit the header (never sent on plain HTTP/localhost).
map $forwarded_proto $hsts_value {
    https   "max-age=31536000; includeSubDomains";
    default "";
}

# Correlation id: keep a client-supplied X-Request-Id (the backend validates its format) or generate one.
map $http_x_request_id $request_id_out {
    ""      $request_id;
    default $http_x_request_id;
}

# Angular's hashed bundles (e.g. main-ABCD1234.js) never change: cache for a year. Other static files: one hour.
map $uri $static_cache_control {
    "~-[A-Z0-9]{8}\.(js|css)$" "public, max-age=31536000, immutable";
    default                  "public, max-age=3600";
}

log_format enterprise '$remote_addr - [$time_local] "$request" $status $body_bytes_sent '
                      'rt=$request_time upstream=$upstream_status rid=$request_id_out';

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    access_log /var/log/nginx/access.log enterprise;
    client_max_body_size 1m;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/manifest+json;

    # ---------------------------------------------------------------- API → backend (never the SPA fallback)
    location ^~ /api/ {
        resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
        set $backend_upstream http://${BACKEND_UPSTREAM};
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        # Overwrite, never append: client-supplied forwarding headers must not reach the backend.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Request-Id $request_id_out;
        proxy_hide_header X-Powered-By;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        error_page 502 503 504 = @api_unavailable;
    }

    location = /api {
        return 404;
    }

    location @api_unavailable {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Request-Id $request_id_out always;
        return 503 '{"status":503,"error":"Service Unavailable","message":"The service is temporarily unavailable. Please try again shortly.","requestId":"$request_id_out"}';
    }

    # ---------------------------------------------------------------- never served
    location ~ /\. {
        return 404;
    }

    location ~* \.map$ {
        return 404;
    }

    # ---------------------------------------------------------------- static assets
    location ~* \.(?:js|css|ico|svg|png|jpe?g|webp|gif|woff2?|txt|webmanifest)$ {
        try_files $uri =404;
        add_header Cache-Control $static_cache_control always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # ---------------------------------------------------------------- SPA (index.html is never cached)
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
